# Application
NODE_ENV=development

# Supabase
# Add the values from the Supabase project Connect/API settings.
# These are public client configuration values, not service-role secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# IMPORTANT:
# Do not put SUPABASE_SERVICE_ROLE_KEY in this file yet.
# A service-role key must remain server-only and will only be introduced
# if a documented administrative server-side use case requires it.

# Public application URL used for authentication callbacks.
# Example: https://your-production-domain.com
NEXT_PUBLIC_SITE_URL=

# Supabase server-only administration
# NEVER expose this with NEXT_PUBLIC_ and NEVER commit the real value.
SUPABASE_SERVICE_ROLE_KEY=
